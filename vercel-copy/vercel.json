{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/gateway.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "site/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/gateway?resource=$1"
    }
  ]
}
